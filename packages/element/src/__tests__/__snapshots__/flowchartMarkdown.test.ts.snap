exports[`Markdown routes > exports the complete Fullfillment Engine Example sample deterministically 1`] = `
"# Prozess: Fullfillment Engine Example

- Start (Closed Sale)
- Send Client Agreement
- Signed?
  - No:
    - Follow Up / Resell if needed
    - zurück zu "Signed?"
  - Yes:
    - Create Client Dashboard & OS Canvas
    - Create Account & Add GSA License in Portal
    - Send Welcome Email
    - Schedule Kickstart Call
    - Deliver Kickstart & Triage Session
    - All 1-on-1 Calls Scheduled?
      - No:
        - Follow Up with Client until ALL are scheduled
        - zurück zu "All 1-on-1 Calls Scheduled?"
      - Yes:
        - Deliver 1-on-1 Implementation Session
        - OS Tool Complete?
          - No:
            - Create Catchup Plan with Client
            - Implement Catchup Plan
            - zurück zu "OS Tool Complete?"
          - Yes:
            - OS Canvas Complete?
              - No: zurück zu "Deliver 1-on-1 Implementation Session"
              - Yes:
                - Ask for a testimonial
                - Deliver HWGT Session
                - Present Offer for Ongoing Support
                  - No:
                    - Off-board Client
                    - Referal Request
                    - End
                  - Yes:
                    - Ascend to FB or S&E?
                      - No:
                        - Off-board Client
                        - Referal Request
                        - End
                      - Yes FB:
                        - Hand off to Founders-Board Team
                      - Yes S&E:
                        - Start S&E Coaching"
`;

exports[`Markdown routes > exports the complete Growth Engine Example sample deterministically 1`] = `
"# Prozess: Growth Engine Example

## Einstieg: Hand-Raiser E-Mail Campaign

- Hand-Raiser E-Mail Campaign
- Conversion / Sell-by-chat
- weiter mit "Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)"

## Einstieg: Start

- Start
- FB / IG Ads
- Lead Magnet or Webinar Landing Page
- weiter mit "Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)"

## Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)

- Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)
  - No:
    - Level 7 Masterclass
    - Bought L7MC?
      - No:
        - L7MC Follow up sequence
          - After 10 days:
            - Email List
            - Lead Magnet or Webinar Landing Page
            - zurück zu "Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)"
          - Verbindung ohne Beschriftung: zurück zu "Bought L7MC?"
      - Yes:
        - Scalable Intensive Bundle
        - Scalable Growth Accellerator
        - Start L7 Fullfillment Engine
  - Yes:
    - Book a meeting
    - Booked?
      - No:
        - Follow Up Campaign
        - Qualified? (nach Follow Up Campaign)
          - No:
            - DQ/Closed /Lost
            - Email List
            - Lead Magnet or Webinar Landing Page
            - zurück zu "Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)"
          - Yes:
            - Book with AE
            - Meeting Show-up Series (nach Book with AE)
            - weiter mit "Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)"
      - Yes:
        - Lead Status?
          - A Lead:
            - Book with AE
            - Meeting Show-up Series (nach Book with AE)
            - weiter mit "Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)"
          - B Lead:
            - Book with MDR
            - Meeting Show-up series (nach Book with MDR)
            - Attended? (nach Meeting Show-up series (nach Book with MDR))
              - No:
                - Setter Follow Up
                - weiter mit "Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)"
              - Yes:
                - Deliver Triage Session
                - Qualified? (nach Deliver Triage Session)
                  - No:
                    - DQ/Closed /Lost
                    - Email List
                    - Lead Magnet or Webinar Landing Page
                    - zurück zu "Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)"
                  - Verbindung ohne Beschriftung:
                    - Book with AE
                    - Meeting Show-up Series (nach Book with AE)
                    - weiter mit "Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)"

## Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)

- Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)
  - No:
    - Setter Follow Up
    - zurück zu "Attended? (nach Meeting Show-up Series (nach Book with AE) / Setter Follow Up)"
  - Yes:
    - Deliver Growth Session
    - Offer Presented?
      - No: weiter mit "Follow-Up (BAMFAM)"
      - Verbindung ohne Beschriftung:
        - Closed?
          - No: weiter mit "Follow-Up (BAMFAM)"
          - Verbindung ohne Beschriftung:
            - Start OSA Fulfillment Engine
          - Verbindung ohne Beschriftung:
            - Start FB Fullfillment Engine

## Follow-Up (BAMFAM)

- Follow-Up (BAMFAM)
  - After 21 Days:
    - DQ/Closed /Lost
    - Email List
    - Lead Magnet or Webinar Landing Page
    - weiter mit "Qualified? (nach Conversion / Sell-by-chat / Lead Magnet or Webinar Landing Page)"
  - Verbindung ohne Beschriftung: weiter mit "Deliver Growth Session""
`;
